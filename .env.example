# Agent Command Center - deployment configuration
# Copy to .env and fill in. Secrets belong in hosting secrets, never in Git.

# ---------------------------------------------------------------------------
# Who this workspace belongs to
# ---------------------------------------------------------------------------
# Shown in the interface and given to the agents as who they work for.
OWNER_NAME=

# ---------------------------------------------------------------------------
# Model gateway (OpenAI-compatible; LiteLLM recommended)
# ---------------------------------------------------------------------------
LLM_GATEWAY_URL=https://your-gateway.example.com/v1
LLM_GATEWAY_API_KEY=replace-with-a-secret

# Per-call timeout, retry attempts per provider, and backoff bounds.
LLM_GATEWAY_TIMEOUT_MS=45000
LLM_GATEWAY_MAX_ATTEMPTS=2
LLM_GATEWAY_BACKOFF_MS=400
LLM_GATEWAY_MAX_BACKOFF_MS=6000

# ---------------------------------------------------------------------------
# Exact model IDs configured in your gateway
# ---------------------------------------------------------------------------
MODEL_OPENAI=openai/your-model
MODEL_GEMINI=gemini/your-model
MODEL_CLAUDE=anthropic/your-model
MODEL_PERPLEXITY=perplexity/your-model

# Keep Auto Router cost data aligned with the models in your account.
# Supported tiers: free, low, standard, premium
ROUTER_PREFER_FREE=true
MODEL_OPENAI_TIER=standard
MODEL_GEMINI_TIER=free
MODEL_CLAUDE_TIER=standard
MODEL_PERPLEXITY_TIER=standard

# Optional exact API prices per 1,000,000 tokens. Supplying both the input and
# output price for every enabled route turns on projected and actual spend.
MODEL_OPENAI_INPUT_COST_PER_M=
MODEL_OPENAI_OUTPUT_COST_PER_M=
MODEL_GEMINI_INPUT_COST_PER_M=
MODEL_GEMINI_OUTPUT_COST_PER_M=
MODEL_CLAUDE_INPUT_COST_PER_M=
MODEL_CLAUDE_OUTPUT_COST_PER_M=
MODEL_PERPLEXITY_INPUT_COST_PER_M=
MODEL_PERPLEXITY_OUTPUT_COST_PER_M=

# Usable context window per route, in tokens. Routes that cannot hold the
# request are excluded before ranking. Defaults are conservative.
MODEL_OPENAI_CONTEXT=200000
MODEL_GEMINI_CONTEXT=1000000
MODEL_CLAUDE_CONTEXT=200000
MODEL_PERPLEXITY_CONTEXT=128000

# Optional per-route capability overrides, 0-10.
# Keys: quick, writing, coding, research, longContext, reasoning
# MODEL_GEMINI_STRENGTHS=coding:9,longContext:10

# Disable a route without removing its model settings.
MODEL_OPENAI_ENABLED=true
MODEL_GEMINI_ENABLED=true
MODEL_CLAUDE_ENABLED=true
MODEL_PERPLEXITY_ENABLED=true

# ---------------------------------------------------------------------------
# Orchestration
# ---------------------------------------------------------------------------
# How many times the Verifier may send corrections back to the Builder.
ORCHESTRATOR_MAX_REVISIONS=1

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Refuse anonymous mission runs. Strongly recommended for a public deployment.
REQUIRE_SIGNED_IN=false
# Optional shared secret for scripted callers, sent as `x-mission-token`.
MISSION_API_TOKEN=

# Rate limits. Per-minute is enforced in memory (burst protection); the daily
# cap is counted in D1 and is the durable one.
RATE_LIMIT_RUNS_PER_MINUTE=6
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_RUNS_PER_DAY=120
